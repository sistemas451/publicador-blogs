{
  "name": "publicador-blogs",
  "version": "0.1.0",
  "private": true,
  "description": "Publicador de blogs de Myselec: crea borradores en WordPress. Nunca publica.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:client": "vite --config client/vite.config.mjs",
    "build": "vite build --config client/vite.config.mjs && prisma generate",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7"
  }
}
