// Base propia del publicador. No comparte nada con la base del CRM.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  passwordHash      String
  isAdmin           Boolean    @default(false)
  active            Boolean    @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  tokens            Token[]
  drafts            Draft[]
  guardados         Guardado[]
  logins            LoginLog[]
}

enum TokenType {
  INVITE
  RESET
}

// El token en claro nunca se guarda: solo su hash.
model Token {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginLog {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Autores que se pueden elegir al crear un blog. No son usuarios del sistema: solo salen escritos en el texto.
model Author {
  id        String   @id @default(cuid())
  name      String
  role      String?
  linkUrl   String?
  photoUrl  String?
  photoMediaId Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum DraftStatus {
  CREADO
  FALLIDO
}

// Registro de quién creó qué borrador y cuándo.
model Draft {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  title       String
  wpPostId    Int?
  wpEditUrl   String?
  wpLink      String?
  categoryId  Int?
  authorLine  String?
  imageCount  Int         @default(0)
  status      DraftStatus
  error       String?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
}

// Blog a medio armar, guardado en la app con "Guardar en la app": todavía no se mandó a WordPress. Se borra solo
// cuando se envía a WordPress (o lo borra la persona).
model Guardado {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String           @default("")
  categoryId Int?
  authorId   String?
  html       String           @default("")
  featured   Int?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  imagenes   GuardadoImagen[]

  @@index([userId])
}

// Imágenes de un guardado (ya achicadas por la pantalla). `posicion` es el número que usa el texto (data-imagen).
model GuardadoImagen {
  id         String   @id @default(cuid())
  guardadoId String
  guardado   Guardado @relation(fields: [guardadoId], references: [id], onDelete: Cascade)
  posicion   Int
  nombre     String
  mime       String
  alt        String   @default("")
  datos      Bytes

  @@unique([guardadoId, posicion])
}
